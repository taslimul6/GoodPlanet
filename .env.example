# ---------------------------------------------------------------------------
# Main API endpoint (public, used in frontend)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_MAIN_API = http://localhost:5000

# ---------------------------------------------------------------------------
# Featured API endpoint
# ---------------------------------------------------------------------------
FEATURED_API = http://localhost:5000/featured

# ---------------------------------------------------------------------------
# Better Auth secret key (used to sign and encrypt session tokens)
# Generate a strong secret: https://www.better-auth.com/docs/installation
# ---------------------------------------------------------------------------
BETTER_AUTH_SECRET = your_super_secret_key_here_min_32_chars

# ---------------------------------------------------------------------------
# Base URL of your application (used by better-auth for callbacks)
# ---------------------------------------------------------------------------
BETTER_AUTH_URL = http://localhost:3000

# ---------------------------------------------------------------------------
# MongoDB connection string
# Format: mongodb://<user>:<password>@<host>:<port>/<db>?<options>
# For local dev: mongodb://localhost:27017/goodplanet
# For Atlas: use your Atlas SRV or standard connection string
# ---------------------------------------------------------------------------
MONGODB_URI = "mongodb://localhost:27017/goodplanet"

# ---------------------------------------------------------------------------
# Google OAuth Client ID (from Google Cloud Console > APIs & Services > Credentials)
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID = your_google_client_id_here

# ---------------------------------------------------------------------------
# Google OAuth Client Secret (from Google Cloud Console > APIs & Services > Credentials)
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_SECRET = your_google_client_secret_here

# ---------------------------------------------------------------------------
# Public Better Auth URL (used in client-side auth, optional but recommended)
# Should match BETTER_AUTH_URL
# ---------------------------------------------------------------------------
NEXT_PUBLIC_BETTER_AUTH_URL = http://localhost:3000
# ImgBB API key for profile photo uploads (https://api.imgbb.com/)
IMGBB_API_KEY=
